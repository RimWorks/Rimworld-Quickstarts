<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Quickstarts.Patches.Harmony</AssemblyName>
    <RootNamespace>RimWorks.Quickstarts.Patches.Harmony</RootNamespace>
    <OutDir>$(MSBuildProjectDirectory)\..\..\Harmony\Assemblies\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.3.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.RimLogging" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private=false: Quickstarts.dll ships once, from the root Assemblies folder. -->
    <ProjectReference Include="..\Quickstarts\Quickstarts.csproj" Private="false" />
  </ItemGroup>
</Project>
