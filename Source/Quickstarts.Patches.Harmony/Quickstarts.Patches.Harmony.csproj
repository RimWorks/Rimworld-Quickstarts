<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Quickstarts.Patches.Harmony</AssemblyName>
    <RootNamespace>RimWorks.Quickstarts.Patches.Harmony</RootNamespace>
    <OutDir>$(MSBuildProjectDirectory)\..\..\$(GameVersion)\Harmony\Assemblies\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GamecrateRefs)/*.dll"
               Exclude="$(GamecrateRefs)/System.*.dll;$(GamecrateRefs)/System.dll;$(GamecrateRefs)/Microsoft.*.dll;$(GamecrateRefs)/mscorlib.dll;$(GamecrateRefs)/netstandard.dll;$(GamecrateRefs)/WindowsBase.dll">
      <Private>False</Private>
    </Reference>
    <PackageReference Include="Lib.Harmony" Version="3.0.*-*" ExcludeAssets="runtime" PrivateAssets="all" Condition="'$(HarmonyLocal)' != 'true'" />
    <Reference Include="$(HarmonyDir)/0Harmony.dll" Private="False" Condition="'$(HarmonyLocal)' == 'true'" />
    <PackageReference Include="RimWorks.RimLogging" Version="3.*" ExcludeAssets="runtime" PrivateAssets="all" Condition="'$(GameVersion)' != '1.7'" />
    <ProjectReference Include="$(RimLoggingProject)" Private="false" PrivateAssets="all" Condition="'$(GameVersion)' == '1.7'" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private=false: Quickstarts.dll ships once, from the version's Assemblies folder. -->
    <ProjectReference Include="..\Quickstarts\Quickstarts.csproj" Private="false" />
  </ItemGroup>
</Project>
