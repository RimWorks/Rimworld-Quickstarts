<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net472 is what the game loads. net10.0 exists so coverlet has a modern assembly to
         instrument, and never ships. -->
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <AssemblyName>Quickstarts</AssemblyName>
    <RootNamespace>RimWorks.Quickstarts</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

    <!-- The game reads Assemblies/, so only the shipped build lands there. -->
    <OutDir Condition="'$(TargetFramework)' == 'net472'">$(MSBuildProjectDirectory)\..\..\Assemblies\</OutDir>
    <AppendTargetFrameworkToOutputPath Condition="'$(TargetFramework)' == 'net472'">false</AppendTargetFrameworkToOutputPath>

    <!-- The game packages are net472. The rest fire because net10.0 has APIs and nullability
         annotations net472 lacks, so the shipped build cannot take the suggestion. -->
    <NoWarn Condition="'$(TargetFramework)' != 'net472'">$(NoWarn);NU1701;NU1702;S8969;CS8600;CA2249</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GamecrateRefs)/*.dll" Condition="'$(HasGameRefs)' == 'true'"
               Exclude="$(GamecrateRefs)/System.*.dll;$(GamecrateRefs)/System.dll;$(GamecrateRefs)/Microsoft.*.dll;$(GamecrateRefs)/mscorlib.dll;$(GamecrateRefs)/netstandard.dll;$(GamecrateRefs)/WindowsBase.dll">
      <Private>False</Private>
    </Reference>
    <!-- Compile-only: the RimLogging mod ships the dll, so a bundled copy would load twice. -->
    <PackageReference Include="RimWorks.RimLogging" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(HasGameRefs)' == 'false'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Quickstarts.Tests" />
  </ItemGroup>
</Project>
