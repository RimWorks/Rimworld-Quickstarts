<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- GameTfm is what the game loads. On net472 the extra net10.0 build gives coverlet a
         modern assembly to instrument and never ships; on 1.7 the two are the same build. -->
    <TargetFrameworks>$(GameTfm);net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(GameTfm)' == 'net10.0'">net10.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <AssemblyName>Quickstarts</AssemblyName>
    <RootNamespace>RimWorks.Quickstarts</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

    <!-- The game reads <version>/Assemblies/, so only the shipped build lands there. -->
    <OutDir Condition="'$(TargetFramework)' == '$(GameTfm)'">$(MSBuildProjectDirectory)\..\..\$(GameVersion)\Assemblies\</OutDir>
    <AppendTargetFrameworkToOutputPath Condition="'$(TargetFramework)' == '$(GameTfm)'">false</AppendTargetFrameworkToOutputPath>

    <!-- The game packages are net472. The rest fire because net10.0 has APIs and nullability
         annotations net472 lacks, so the shipped build cannot take the suggestion. -->
    <NoWarn Condition="'$(TargetFramework)' != 'net472'">$(NoWarn);NU1701;NU1702;S8969;CS8600;CA2249</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GamecrateRefs)/*.dll"
               Exclude="$(GamecrateRefs)/System.*.dll;$(GamecrateRefs)/System.dll;$(GamecrateRefs)/Microsoft.*.dll;$(GamecrateRefs)/mscorlib.dll;$(GamecrateRefs)/netstandard.dll;$(GamecrateRefs)/WindowsBase.dll">
      <Private>False</Private>
    </Reference>
    <!-- Compile-only: the RimLogging mod ships the dll, so a bundled copy would load twice. -->
    <PackageReference Include="RimWorks.RimLogging" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Quickstarts.Tests" />
  </ItemGroup>
</Project>
