<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Quickstarts.Patches.Concord</AssemblyName>
    <RootNamespace>RimWorks.Quickstarts.Patches.Concord</RootNamespace>
    <OutDir>$(MSBuildProjectDirectory)\..\..\Concord\Assemblies\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GamecrateRefs)/*.dll" Condition="'$(HasGameRefs)' == 'true'"
               Exclude="$(GamecrateRefs)/System.*.dll;$(GamecrateRefs)/System.dll;$(GamecrateRefs)/Microsoft.*.dll;$(GamecrateRefs)/mscorlib.dll;$(GamecrateRefs)/netstandard.dll;$(GamecrateRefs)/WindowsBase.dll">
      <Private>False</Private>
    </Reference>
    <PackageReference Include="Concord.Ref" Version="0.24.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.RimLogging" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(HasGameRefs)' == 'false'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private=false: Quickstarts.dll ships once, from the root Assemblies folder. -->
    <ProjectReference Include="..\Quickstarts\Quickstarts.csproj" Private="false" />
  </ItemGroup>
</Project>
