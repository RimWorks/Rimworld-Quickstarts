<Project>
  <PropertyGroup>
    <!-- On, so an undocumented public member fails the build instead of only dotnet format. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Authors>RimWorks</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.33.*" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="StyleCop.props" />
</Project>
