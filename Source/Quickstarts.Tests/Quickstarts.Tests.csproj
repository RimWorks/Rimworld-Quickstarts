<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- No net472 test host ships for Linux. These tests touch nothing needing Unity or
         Verse, so they run against the mod's net10.0 build instead. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CS1591 is the compiler's copy of SA1600 and ignores the .editorconfig path scoping
         that exempts tests, so it would demand docs the house convention says to skip. -->
    <NoWarn>$(NoWarn);NU1701;NU1702;CS8032;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.*" />
    <PackageReference Include="coverlet.collector" Version="10.0.*" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.*" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Quickstarts\Quickstarts.csproj" />
  </ItemGroup>
</Project>
